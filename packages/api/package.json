{
  "name": "@workspace-welcome/api",
  "type": "module",
  "exports": {
    ".": {
      "default": "./src/index.ts"
    },
    "./*": {
      "default": "./src/*.ts"
    }
  },
  "scripts": {
    "agents-md": "tsx src/lib/agents-md/cli.ts",
    "check-types": "tsc --noEmit -p tsconfig.check.json",
    "test:store": "node --import tsx --test src/lib/store.import.test.ts src/lib/project-config.import.test.ts",
    "test:forge": "node --import tsx --test src/lib/detect.test.ts src/lib/forge/*.test.ts",
    "test:clone": "node --import tsx --test src/lib/clone-job.test.ts"
  },
  "dependencies": {
    "@tanstack/ai": "catalog:",
    "@tanstack/ai-openai": "catalog:",
    "@tanstack/ai-openrouter": "catalog:",
    "@trpc/client": "catalog:",
    "@trpc/server": "catalog:",
    "@workspace-welcome/db": "workspace:*",
    "@workspace-welcome/env": "workspace:*",
    "create-better-t-stack": "^3.40.3",
    "dotenv": "catalog:",
    "drizzle-orm": "catalog:",
    "jsonc-parser": "^3.3.1",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@workspace-welcome/config": "workspace:*",
    "tsx": "^4.19.2",
    "typescript": "catalog:"
  }
}
