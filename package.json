{
  "name": "workspace-welcome",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "type": "module",
  "scripts": {
    "dev": "pnpm --filter web dev",
    "build": "pnpm -r build",
    "check-types": "pnpm -r check-types",
    "dev:web": "pnpm --filter web dev",
    "dev:docs": "pnpm --filter docs dev",
    "build:docs": "pnpm --filter docs build",
    "prepare:docs-pages": "node scripts/prepare-docs-deploy.js",
    "deploy:docs": "pnpm run build:docs && pnpm run prepare:docs-pages && node scripts/deploy-docs-gh-pages.js",
    "release": "bash scripts/release.sh",
    "test:install": "bash scripts/test-install.sh"
  },
  "dependencies": {
    "@workspace-welcome/env": "workspace:*",
    "dotenv": "catalog:",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@types/node": "catalog:",
    "@workspace-welcome/config": "workspace:*",
    "gh-pages": "^6.3.0",
    "typescript": "catalog:"
  },
  "packageManager": "pnpm@10.33.4"
}
